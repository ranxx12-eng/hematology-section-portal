# =============================================================================
# Hematology Section Portal — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# --- Supabase (required for production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Riyadh

# --- Demo Mode (local development ONLY — never enable in production) ---
# When true, uses local mock data and demo accounts. Production MUST set this to false.
NEXT_PUBLIC_DEMO_MODE=false
# Demo password used only when NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PASSWORD=change-me-local-dev-only

# --- Optional: OpenAI (AI Assistant module) ---
# OPENAI_API_KEY=your-openai-api-key

# --- Optional: Email provider ---
# EMAIL_PROVIDER_API_KEY=your-email-provider-key
